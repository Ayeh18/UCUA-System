# Store and check out text files with LF endings on every OS, so formatters
# (Prettier, ruff) and Linux containers see the same files as CI.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.avif binary
*.ico binary
