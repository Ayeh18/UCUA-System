# Leave empty in development: Vite proxies /api and /uploads to VITE_PROXY_TARGET.
# Set to the API origin (e.g. https://api.ucua.example.com) only if the API is served
# from a different origin than the frontend in production.
VITE_API_URL=

# Where the dev server proxies API calls (development only)
VITE_PROXY_TARGET=http://localhost:8001

# Extra hostnames allowed to reach the dev server, comma-separated (e.g. an ngrok tunnel)
VITE_ALLOWED_HOSTS=
